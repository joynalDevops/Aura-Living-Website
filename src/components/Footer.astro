---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/" aria-label={`${site.name} home`}>
        <img class="brand-logo" src={site.logo} alt={`${site.name} official logo`} width="88" height="88" />
        <span class="brand-name">Aura <strong>Living LLC</strong></span>
      </a>
      <p>Official contact: <a href={`mailto:${site.email}`}>{site.email}</a> · <a href="tel:+17038284040">{site.phone}</a></p>
    </div>
    <div>
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        <li><a href="/services/">Services</a></li>
        <li><a href="/about/">About Aura Living LLC</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Connect</h2>
      <ul class="footer-links">
        <li><a href="/contact/">Contact</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="tel:+17038284040">{site.phone}</a></li>
        <li><span>{site.address}</span></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}.</span>
    <div><a href="/privacy-policy/">Privacy Policy</a><a href="/sms-terms/">SMS Terms</a></div>
  </div>
</footer>
