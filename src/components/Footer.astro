---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/" aria-label="Aura Living home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span class="brand-name">Aura <strong>Living</strong></span>
      </a>
      <p>Thoughtful property care and resident support for Virginia homes.</p>
      <p class="footer-note">Content and contact details are ready for review.</p>
    </div>
    <div>
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        <li><a href="/services/">Services</a></li>
        <li><a href="/about/">About Aura Living</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Connect</h2>
      <ul class="footer-links">
        <li><a href="/contact/">Contact</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><span>{site.phone} <small>(placeholder)</small></span></li>
        <li><span>{site.address} <small>(placeholder)</small></span></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Aura Living.</span>
    <div><a href="/privacy-policy/">Privacy Policy</a><a href="/sms-terms/">SMS Terms</a></div>
  </div>
</footer>
